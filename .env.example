# Copy to .env and fill in. Never commit .env.
# Everything here is optional: the default path runs on local Ollama with no keys.
HF_TOKEN=

# Free/open model through any OpenAI-compatible endpoint (optional; see llm/openai_compat.py).
# Default base URL is local Ollama. For a hosted provider, set its URL and key here.
SAATHI_LLM_BASE_URL=http://localhost:11434/v1
SAATHI_LLM_API_KEY=
SAATHI_LLM_MODEL=
# Leave the prices at 0 for free backends; set them (USD per million tokens) for paid ones
# so the --max-usd guards see the real cost.
SAATHI_LLM_PRICE_IN=0
SAATHI_LLM_PRICE_OUT=0
# json_schema | json_object | prompt (use json_object or prompt if the server rejects schemas)
SAATHI_LLM_JSON_MODE=json_schema

# OPTIONAL paid Claude backend: `uv sync --extra claude`, then fill in.
ANTHROPIC_API_KEY=

# Tracing for the arm-5 agent: fill in ONE of the two blocks.
# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=schemesaathi-bench
# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

OLLAMA_HOST=http://localhost:11434
