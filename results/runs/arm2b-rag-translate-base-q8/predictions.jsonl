{"run_id":"arm2b-rag-translate-base-q8","qa_id":"hw-pmjjby-01-en","output":{"answer":{"text":"Under PMJJBY, Rs.2 lakh is payable on a subscriber’s death due to any cause.","citations":["pmjjby:d1-page-1:0"],"refused":false},"retrieved":["pmjjby:d1-page-5:0","pmjjby:d1-page-4:1","pmjjby:d0-page-2:2","pmjjby:d1-page-1:0","pm-kmy:d1-page-1:1"],"usage":[{"requested_model":"qwen3-1.7b-base:q8_0","served_model":"qwen3-1.7b-base:q8_0","input_tokens":1123,"output_tokens":48,"latency_s":51.25790340000094,"cost_usd":0.0}],"latency_s":53.34350809999887,"parse_error":null,"search_query":null}}
