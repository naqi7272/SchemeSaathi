{"run_id":"arm2b-rag-translate-base-q8","qa_id":"hw-pmkmy-04-en","output":{"answer":{"text":"Under PM-KMY, a farmer is considered a small and marginal farmer if they own cultivable land up to 2 hectares as per land records of the concerned State/UT.","citations":["pm-kmy:d1-page-1:0"],"refused":false},"retrieved":["pm-kmy:d1-page-1:0","pm-kmy:d0-page-1:0","pm-kmy:d0-page-1:1","pm-kmy:d0-page-4:1","pm-kmy:d1-page-1:2"],"usage":[{"requested_model":"qwen3-1.7b-base:q8_0","served_model":"qwen3-1.7b-base:q8_0","input_tokens":1219,"output_tokens":63,"latency_s":79.83834829999978,"cost_usd":0.0}],"latency_s":80.13658930000383,"parse_error":null,"search_query":null}}
